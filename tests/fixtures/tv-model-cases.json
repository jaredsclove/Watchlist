{
  "_about": "Shared cases for the TV-show model. Used by tests/tv-model.test.js (JavaScript reference) and tools/db-rehearsal.mjs (database implementation). Seasons are in no particular order; 'today' is fixed. Fields omitted from a season default to: watched false, skipped false, a dated past release.",
  "today": "2026-10-04",
  "upNext": [
    { "name": "Example A: S1 watched, S2 unwatched, S3 watched, S4 unwatched", "seasons": [["S1", 1, "w"], ["S2", 2], ["S3", 3, "w"], ["S4", 4]], "upNext": "S4", "upToDate": false },
    { "name": "Example B: S1-S3 unwatched, S4 watched, S5 unwatched", "seasons": [["S1", 1], ["S2", 2], ["S3", 3], ["S4", 4, "w"], ["S5", 5]], "upNext": "S5", "upToDate": false },
    { "name": "Example C: S1 watched, S2 skipped, S3 unwatched", "seasons": [["S1", 1, "w"], ["S2", 2, "s"], ["S3", 3]], "upNext": "S3", "upToDate": false },
    { "name": "Example D: nothing watched", "seasons": [["S2", 2], ["S1", 1], ["S3", 3]], "upNext": "S1", "upToDate": false },
    { "name": "Example D with a skipped first season", "seasons": [["S1", 1, "s"], ["S2", 2], ["S3", 3]], "upNext": "S2", "upToDate": false },
    { "name": "Example E: S1 w, S2 u, S3 skipped, S4 w, S5 u", "seasons": [["S1", 1, "w"], ["S2", 2], ["S3", 3, "s"], ["S4", 4, "w"], ["S5", 5]], "upNext": "S5", "upToDate": false },
    { "name": "Example F: S1-S4 watched, S5 TBA", "seasons": [["S1", 1, "w"], ["S2", 2, "w"], ["S3", 3, "w"], ["S4", 4, "w"], ["S5", 5, "tba"]], "upNext": "S5", "upToDate": true },
    { "name": "Future-dated next season keeps the show Up to date", "seasons": [["S1", 1, "w"], ["S2", 2, "future"]], "upNext": "S2", "upToDate": true },
    { "name": "Season airing today counts as aired", "seasons": [["S1", 1, "w"], ["S2", 2, "today"]], "upNext": "S2", "upToDate": false },
    { "name": "Nothing remaining: all watched", "seasons": [["S1", 1, "w"], ["S2", 2, "w"]], "upNext": null, "upToDate": true },
    { "name": "Nothing remaining: rest skipped", "seasons": [["S1", 1, "w"], ["S2", 2, "s"], ["S3", 3, "s"]], "upNext": null, "upToDate": true },
    { "name": "A watched-and-skipped season still moves the furthest point", "seasons": [["S1", 1], ["S2", 2, "ws"], ["S3", 3]], "upNext": "S3", "upToDate": false },
    { "name": "Specials never up next when numbered seasons exist", "seasons": [["SP", 0], ["S1", 1, "w"], ["S2", 2, "w"]], "upNext": null, "upToDate": true },
    { "name": "A watched special doesn't move the furthest point", "seasons": [["SP", 0, "w"], ["S1", 1], ["S2", 2]], "upNext": "S1", "upToDate": false },
    { "name": "Standalone special (only specials)", "seasons": [["SP", "Special"]], "upNext": "SP", "upToDate": false },
    { "name": "Standalone special, watched", "seasons": [["SP", "Special", "w"]], "upNext": null, "upToDate": true },
    { "name": "Part seasons ordered by date, then label", "seasons": [["P2", "Season 5 (Part 2)", "", "2025-06-01"], ["P1", "Season 5 (Part 1)", "w", "2025-01-01"], ["S4", "Season 4", "w", "2024-01-01"]], "upNext": "P2", "upToDate": false },
    { "name": "Volumes are numbered seasons", "seasons": [["V1", "Volume 1", "w"], ["V2", "Volume 2"], ["V3", "Volume 3", "tba"]], "upNext": "V2", "upToDate": false },
    { "name": "Final-season label parses its number", "seasons": [["S4", "Season 4", "w"], ["S5", "Season 5 (Final)", "tba"]], "upNext": "S5", "upToDate": true },
    { "name": "Unparsable label sorts last", "seasons": [["X", "Bonus Disc"], ["S1", "Season 1", "w"]], "upNext": "X", "upToDate": false },
    { "name": "TBA by 2099 date_sort without TBA text", "seasons": [["S1", 1, "w"], ["S2", 2, "2099"]], "upNext": "S2", "upToDate": true }
  ],
  "migration": [
    { "name": "one status throughout", "statuses": ["confirmed", "confirmed"], "status": "confirmed", "skipped": [] },
    { "name": "all watching", "statuses": ["watching", "watching", "watching"], "status": "watching", "skipped": [] },
    { "name": "all skipped: show Skipped, flags cleared", "statuses": ["skipped", "skipped"], "status": "skipped", "skipped": [] },
    { "name": "On List + Watching", "statuses": ["confirmed", "watching", "confirmed"], "status": "watching", "skipped": [] },
    { "name": "Skipped + Watching", "statuses": ["skipped", "skipped", "watching"], "status": "watching", "skipped": [0, 1] },
    { "name": "On List + Skipped", "statuses": ["skipped", "confirmed"], "status": "confirmed", "skipped": [0] },
    { "name": "On List + Pending", "statuses": ["confirmed", "pending"], "status": "confirmed", "skipped": [] },
    { "name": "On List + Pending + Skipped", "statuses": ["skipped", "confirmed", "pending"], "status": "confirmed", "skipped": [0] },
    { "name": "Watching + Pending", "statuses": ["watching", "pending"], "status": "watching", "skipped": [] },
    { "name": "Pending + Skipped (round trip of a Pending show)", "statuses": ["pending", "skipped"], "status": "pending", "skipped": [1] },
    { "name": "Complete + Skipped", "statuses": ["complete", "skipped"], "status": "complete", "skipped": [1] },
    { "name": "High Priority + Skipped", "statuses": ["highpriority", "skipped"], "status": "highpriority", "skipped": [1] },
    { "name": "Maybe + Skipped", "statuses": ["maybe", "skipped"], "status": "maybe", "skipped": [1] },
    { "name": "Watching + Complete is unmapped", "statuses": ["watching", "complete"], "unmapped": true },
    { "name": "On List + Complete is unmapped", "statuses": ["confirmed", "complete"], "unmapped": true },
    { "name": "Maybe + Pending is unmapped", "statuses": ["maybe", "pending"], "unmapped": true }
  ]
}
